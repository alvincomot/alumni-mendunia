# Salin ke config.local.env. Jangan isi file contoh ini dengan kredensial nyata.
K6_ENVIRONMENT_NAME=local
K6_BASE_URL=http://127.0.0.1:3000
K6_SUPABASE_URL=http://127.0.0.1:54321
K6_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
K6_CONFIRM_ISOLATED_TARGET=true
K6_CONFIRM_FIXTURES_ARE_FICTITIOUS=true
K6_SESSION_COUNT=1
K6_REPORT_ITERATIONS=5

K6_TEST_EMAIL_PETUGAS_SEKOLAH=petugas.k6@example.test
K6_TEST_PASSWORD_PETUGAS_SEKOLAH='replace-with-local-password'
K6_TEST_NPSN_PETUGAS_SEKOLAH=11111111
K6_TEST_EMAIL_ADMIN_DINAS=admin.k6@example.test
K6_TEST_PASSWORD_ADMIN_DINAS='replace-with-local-password'
K6_TEST_EMAIL_VIEWER_DINAS=viewer.k6@example.test
K6_TEST_PASSWORD_VIEWER_DINAS='replace-with-local-password'

# UUID fixture ditemukan otomatis melalui sesi dan RLS. Override berikut opsional.
# K6_TEST_ALUMNI_ID_PETUGAS_SEKOLAH=
# K6_TEST_ALUMNI_ID_ADMIN_DINAS=
# K6_TEST_ALUMNI_ID_VIEWER_DINAS=
# K6_TEST_MURID_ID_PETUGAS_SEKOLAH=
# K6_TEST_MURID_ID_ADMIN_DINAS=
# K6_TEST_MURID_ID_VIEWER_DINAS=
# K6_TEST_FOREIGN_ALUMNI_ID_PETUGAS_SEKOLAH=
